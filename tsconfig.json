{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.vue",
    "tests/frontend/**/*.ts",
    "tests/frontend/**/*.vue",
    "vite.config.ts"
  ],
  "exclude": [
    "resources/js/components/WebAwesomePro/**",
    "resources/js/WebAwesome/proComponentProps.ts"
  ]
}
