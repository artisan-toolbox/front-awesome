    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.vue",
    "tests/frontend/**/*.ts",
    "vite.config.ts"
  ]
}
