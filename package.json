  "scripts": {
    "build": "vp build",
    "dev": "vp dev",
    "test": "vp test run --project unit",
    "test:browser": "vp test run --project chromium",
    "test:coverage": "vp test run --coverage",
    "check": "vp check && npm run typecheck && npm run theme:check && npm run components:check && npm run examples:check && npm run translations:check",
    "check:fix": "vp check --fix",
    "typecheck": "vue-tsc --noEmit",
    "theme:generate": "node scripts/generate-theme.mjs",
    "theme:check": "node scripts/generate-theme.mjs --check && node scripts/check-theme-compatibility.mjs",
    "test:theme": "node scripts/test-peer-installation.mjs && node scripts/test-theme-consumer.mjs",
    "components:generate": "node scripts/generate-web-awesome.mjs",
    "components:check": "node scripts/generate-web-awesome.mjs --check",
    "components:generate:pro": "node scripts/generate-web-awesome.mjs --pro",
    "components:check:pro": "node scripts/generate-web-awesome.mjs --pro --check",
    "typecheck:pro": "vue-tsc --noEmit --project tsconfig.pro.json",
    "test:pro": "FRONT_AWESOME_PRO=1 vp test run",
    "test:pro:browser": "FRONT_AWESOME_PRO=1 vp test run --project chromium",
    "examples:generate": "node scripts/generate-upstream-scenarios.mjs && node scripts/generate-upstream-scenarios.mjs --coverage",
    "examples:generate:pro": "node scripts/generate-upstream-scenarios.mjs --pro && node scripts/generate-upstream-scenarios.mjs --coverage",
    "examples:check": "node scripts/generate-upstream-scenarios.mjs --check && node scripts/generate-upstream-scenarios.mjs --coverage --check",
    "examples:check:pro": "node scripts/generate-upstream-scenarios.mjs --pro --check && node scripts/generate-upstream-scenarios.mjs --coverage --check",
    "translations:generate": "node scripts/generate-printing-messages.mjs && node scripts/generate-localization-casing.mjs",
    "translations:check": "node scripts/generate-printing-messages.mjs --check && node scripts/generate-localization-casing.mjs --check"
  },
